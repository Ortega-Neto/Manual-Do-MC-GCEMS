<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_0"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:padding="@dimen/margin_24"
        android:rowCount="2"
        android:rowOrderPreserved="false"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toTopOf="@+id/linearLayoutPackages"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/package_create"
            layout="@layout/component_card_image_name"
            android:layout_width="@dimen/margin_0"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="@dimen/margin_24" />

        <include
            android:id="@+id/package_send"
            layout="@layout/component_card_image_name"
            android:layout_width="@dimen/margin_0"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="@dimen/margin_24" />

    </GridLayout>

    <LinearLayout
        android:id="@+id/linearLayoutPackages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_16"
        android:layout_marginVertical="@dimen/margin_24"
        android:background="@drawable/bg_alert_box"
        android:orientation="horizontal"
        android:padding="@dimen/margin_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/text_view_packages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16"
            android:layout_weight="1"
            android:justificationMode="inter_word"
            android:text="@string/label_placeholder"
            android:textColor="@color/colorSecondary"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textIsSelectable="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>